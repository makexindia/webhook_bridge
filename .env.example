# Required: Secret token to authenticate MCP clients (e.g., Gemini Spark, Claude Desktop, Cursor)
AUTH_TOKEN=your-mcp-access-token-here

# Optional: Secret used to compute canonical HMAC-SHA256 signature on outgoing webhooks
WEBHOOK_HMAC_SECRET=your-webhook-signing-secret-here

# Mandatory in Production: Comma-separated list of allowed destination domains
ALLOWED_WEBHOOK_DOMAINS=example.com,makex.in,api.makex.in
